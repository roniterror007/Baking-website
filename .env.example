# Configure in Vercel Production/Preview and in ignored .env.local for development.
# Supabase Dashboard → Connect → Transaction pooler. Keep this private.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres?sslmode=verify-full
# Supabase Dashboard → Settings → API keys. Publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Secret key (or legacy service_role key) is server-only. Never prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
SUPABASE_STORAGE_BUCKET=cake-references
# Owner access requires this exact verified Supabase email.
OWNER_EMAIL=ronittd2005@gmail.com
# Optional: verified Supabase user UUID, rather than the old Sites user ID.
# OWNER_USER_ID=
